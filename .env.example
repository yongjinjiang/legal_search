# Server-side only. Never prefix secrets with NEXT_PUBLIC_.
DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
DATABRICKS_TOKEN=replace-with-a-short-lived-token
DATABRICKS_INDEX_NAME=workspace.default.legal_chunks_index
DATABRICKS_CHAT_MODEL=your-serving-endpoint-name

# Set to true for a credential-free local demonstration.
MOCK_DATABRICKS=true
