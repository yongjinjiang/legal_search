# Server-side only. Never prefix a secret with NEXT_PUBLIC_.

# ---------------------------------------------------------------------------
# Production configuration
# ---------------------------------------------------------------------------
# Retrieval runs inside the application against the committed artifacts in
# data/search/. There is no search service to provision and nothing bills while
# the site is idle.
SEARCH_BACKEND=local

# One embedding request per semantic or hybrid search, and one chat request per
# technical-guide question or research summary. Full text search calls nothing.
OPENAI_API_KEY=sk-replace-me
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_EMBEDDING_DIMENSIONS=1024
OPENAI_CHAT_MODEL=gpt-5-mini

# The embedding model and dimensions must match the values in
# data/search/index_manifest.json. They are compared at query time and a
# mismatch is refused rather than served as a silently wrong ranking.
# text-embedding-3-small at 512 dimensions was measured first and lost the Q17
# third-party-retaliation relationship; see docs/LOCAL_RETRIEVAL_EVALUATION.md.

# Optional. "minimal" | "low" | "medium" | "high" for gpt-5 and o-series models.
# Leave at the default. Measured on this project's summary prompt, twice each:
#   low      ~28s, 31 page-range citations   <- default, best grounding
#   minimal  ~28s,  6 page-range citations   <- faster to first token, much weaker citation
#   medium   50-66s, and one run spent the entire 4,000-token budget on reasoning and
#            returned nothing, which is the failure the budget was raised to prevent
# medium and high can therefore exceed both the request timeout and the function budget.
# OPENAI_REASONING_EFFORT=low
#
# Values outside the provider's enum are rejected at startup rather than forwarded, and "medium"
# and "high" are refused because they were measured to break this deployment's budgets. To run an
# untested profile deliberately, set the override below and re-run `npm run verify:provider`.
# OPENAI_ALLOW_UNTESTED_REASONING_EFFORT=true
# Optional. Point the OpenAI-compatible calls at another gateway.
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# Local development
# ---------------------------------------------------------------------------
# Credential-free frontend work. Results are fixtures and are labelled as mock
# in the UI. Production must never set this: a failed embedding call has to
# surface as an error, not as plausible-looking fake rankings.
# MOCK_SEARCH=true

# ---------------------------------------------------------------------------
# Optional Pinecone vector backend
# ---------------------------------------------------------------------------
# Moves only the nearest-neighbour step to Pinecone; BM25, fusion, and the
# document table stay local. Upload the committed vectors with
# `npm run index:pinecone` before switching. The public deployment does not use it.
# SEARCH_BACKEND=pinecone
# PINECONE_API_KEY=replace-me
# PINECONE_INDEX_NAME=legal-chunks
# Optional: skips one control-plane lookup per cold instance. The upload script prints it.
# PINECONE_INDEX_HOST=legal-chunks-xxxxxxx.svc.aped-xxxx-xxxx.pinecone.io

# ---------------------------------------------------------------------------
# Historical / optional Databricks comparison backend
# ---------------------------------------------------------------------------
# Phase 1 of this project benchmarked Databricks AI Search. The adapter is kept
# so that prototype can still be re-measured with the same harness, but the
# public deployment does not need any of these and must not set SEARCH_BACKEND
# to databricks.
# SEARCH_BACKEND=databricks
# DATABRICKS_HOST=https://your-workspace.cloud.databricks.com
# DATABRICKS_TOKEN=replace-with-a-short-lived-token
# DATABRICKS_INDEX_NAME=workspace.default.legal_chunks_index

# Required only by the on-demand smoke check at /api/cron/search-check, which is
# no longer scheduled. Vercel would send this as `Authorization: Bearer $CRON_SECRET`.
# CRON_SECRET=generate-with-openssl-rand-base64-32
